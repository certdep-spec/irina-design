{
  "name": "interior-designer-portfolio",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node api-server.mjs\" --names \"vite,api\" --prefix-colors \"cyan,green\"",
    "api": "node api-server.mjs",
    "build": "vite build && vite build --ssr src/ssr-entry.tsx --outDir dist-ssr --config vite.config.ssr.mjs && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:netlify": "netlify dev",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "prepare": "husky"
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "nodemailer": "^9.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^4.12.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.0.4",
    "netlify-cli": "^26.0.0",
    "postcss": "^8.4.31",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.1",
    "vite": "^5.0.0",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-sitemap": "^0.8.2",
    "vitest": "^2.1.9"
  }
}
