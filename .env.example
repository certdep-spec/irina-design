# Admin panel password (SERVER-SIDE ONLY — no VITE_ prefix, never bundled to client).
# Read by api-server.mjs (dotenv), Vercel + Netlify runtime env ADMIN_PASSWORD.
# GH Pages не нужен (он шлёт запросы на API Vercel).
# Set a strong value, e.g. ADMIN_PASSWORD=some-long-random-string
ADMIN_PASSWORD=

# Telegram notifications for contact-form submissions (server-side).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional email fallback (nodemailer) for submissions.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_TO=

# Разрешённые CORS-origin (через запятую). Нужен GH Pages для кросс-домена.
# ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://certdep-spec.github.io

# Только для CI GH Pages: абсолютный URL API-донора (Vercel), т.к. на GH Pages нет serverless.
# VITE_API_BASE=https://irina-design.vercel.app
